# Optional comma-separated Expo Web / Cloudflare origins. Empty permits all origins.
FEEDBACK_ALLOWED_ORIGINS=

# Optional best-effort brrr notifier. Persistence works without these values.
BRRR_NOTIFY_URL=
BRRR_BEARER_TOKEN=

# Optional digest delay in whole minutes. Valid range 5-1440; invalid values fall back to 60.
FEEDBACK_DIGEST_WINDOW_MINUTES=60

# Optional private review URL prefix appended with the feedback UUID.
FEEDBACK_REVIEW_BASE_URL=
